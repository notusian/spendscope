# Copy to .env and adjust. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_NAME=spendscope
DATABASE_USERNAME=spendscope
# Local development only. Generate a real secret for anything deployed.
DATABASE_PASSWORD=spendscope
# Used by the backend directly; docker compose builds this from the parts above.
DATABASE_URL=jdbc:postgresql://localhost:5432/spendscope

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# One of: local, prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Exact origin(s) allowed to call the API with credentials. Comma separated.
# Never a wildcard: it is invalid alongside credentialed requests, and it would
# let any site drive the API with the victim's session cookie.
FRONTEND_ORIGIN=http://localhost:5173

# Must be true in production. Over plain HTTP a Secure cookie is never sent
# back, so login silently fails - which is why it is false for local dev.
SESSION_COOKIE_SECURE=false

# Swagger UI and the OpenAPI document. Disabled by the prod profile.
OPENAPI_ENABLED=true

# ---------------------------------------------------------------------------
# Integration tests
# ---------------------------------------------------------------------------
# Optional. Leave unset to use Testcontainers (requires Docker). Set these to
# run the integration tests against an existing PostgreSQL instead.
# SPENDSCOPE_TEST_DB_URL=jdbc:postgresql://localhost:5432/spendscope_test
# SPENDSCOPE_TEST_DB_USERNAME=spendscope
# SPENDSCOPE_TEST_DB_PASSWORD=spendscope
